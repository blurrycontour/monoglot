<?xml version="1.0" encoding="utf-8"?>
<!-- Waveform mark: the app is about listening.
     
     Drawn as stroked lines rather than filled rectangles so strokeLineCap can
     round the ends. The ratios (heights 1/3, 2/3, 1; bar width half the pitch)
     are shared with AppMark on the Canvas and with /api/app/icon.svg, so the
     three renderings of this mark are the same shape.
     
     A round cap extends the stroke by half its width at each end, so each line
     is drawn shorter than the bar by exactly one stroke width. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:strokeColor="#FFFFFF" android:strokeWidth="5"
        android:strokeLineCap="round" android:pathData="M34,48.5 L34,59.5" />
    <path android:strokeColor="#FFFFFF" android:strokeWidth="5"
        android:strokeLineCap="round" android:pathData="M44,40.5 L44,67.5" />
    <path android:strokeColor="#FFFFFF" android:strokeWidth="5"
        android:strokeLineCap="round" android:pathData="M54,32.5 L54,75.5" />
    <path android:strokeColor="#FFFFFF" android:strokeWidth="5"
        android:strokeLineCap="round" android:pathData="M64,40.5 L64,67.5" />
    <path android:strokeColor="#FFFFFF" android:strokeWidth="5"
        android:strokeLineCap="round" android:pathData="M74,48.5 L74,59.5" />
</vector>
