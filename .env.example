# Every variable the stack reads, in one place.
#
# docker-compose.yml passes this whole file to both services with `env_file`,
# so there is no second list of defaults to keep in step. The only variables
# compose reads for itself — rather than handing to a container — are the image
# coordinates and API_PORT, which it also picks up from here automatically.
#
#   cp .env.example .env
#   sed -i "s|^AUTH_TOKEN=.*|AUTH_TOKEN=$(openssl rand -hex 32)|" .env

# --- Images ---
# Where a production host pulls from. A development machine builds from source
# with `docker compose up -d --build` and ignores these.
IMAGE_REGISTRY=ghcr.io/blurrycontour
IMAGE_TAG=latest

# --- API ---
# Published on the host and listened to inside the container, same number.
API_PORT=8080
# Single static bearer token, the only authentication there is. Generate with:
#   openssl rand -hex 32
AUTH_TOKEN=changeme-run-openssl-rand-hex-32
# Affects the nightly ingest schedule and the timestamps in the logs.
TZ=Europe/Stockholm

# Paths inside the container. /data is the bind mount, so all of these land in
# ./data on the host; there is rarely a reason to change them.
DATABASE_PATH=/data/monoglot.db
AUDIO_DIR=/data/audio
RAW_DIR=/data/raw
# Downloaded dictionary and morphology source files, kept so a reimport or a
# rebuilt container does not re-download 250MB.
DATA_CACHE_DIR=/data/cache
DATA_DIR=./data
# The APK served by the /download install page. A file here wins over the one
# baked into the image, which is what makes a local build available at once.
APK_PATH=/data/apk/monoglot.apk
WORKER_URL=http://worker:9000

# The ingest schedule is not set here. It lives in the database and is edited
# from the app's System tab, so a fresh server ingests only when asked and a
# change does not mean editing a file and restarting a container.
# Run the pipeline once at startup as well. Off by default: restarting the API
# should not cost a full fetch. A genuinely empty instance ingests anyway.
INGEST_ON_START=false

# Machine translation for words the dictionary does not have, via MyMemory.
# 0 disables it and leaves such taps showing nothing.
TRANSLATE_FALLBACK=1

# --- Whisper worker ---
# The transcription model is NOT set here. It lives in the server's `settings`
# table and is chosen from the app's System tab, validated against the worker
# before it is saved, and picked up on the next episode without restarting
# anything. A server that has never been told defaults to KBLab/kb-whisper-small.
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# Release the model after this many idle seconds, so the worker does not hold
# ~600MB between nightly runs. 0 disables. Reload costs ~45s.
WHISPER_IDLE_UNLOAD_SECONDS=600
# Whisper weights. A named volume, not ./data: nothing outside the worker ever
# needs to look at them.
MODEL_CACHE_DIR=/models
