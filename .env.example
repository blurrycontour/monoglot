# --- Postgres ---
POSTGRES_USER=svenska
POSTGRES_PASSWORD=svenska
POSTGRES_DB=svenska
POSTGRES_PORT=5432
DATABASE_URL=postgres://svenska:svenska@postgres:5432/svenska?sslmode=disable

# --- API ---
API_PORT=8080
# Single static bearer token. Generate with: openssl rand -hex 32
AUTH_TOKEN=changeme-run-openssl-rand-hex-32
AUDIO_DIR=/data/audio
RAW_DIR=/data/raw
WORKER_URL=http://worker:9000
# Release APK served by the /download install page
APK_PATH=/data/apk/monoglot.apk
# Nightly ingest (in-process cron), 24h clock, server local time
INGEST_CRON_HOUR=3
INGEST_CRON_MINUTE=30
INGEST_ON_START=false

# --- Whisper worker ---
WHISPER_MODEL=KBLab/kb-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
WORKER_PORT=9000

# --- LLM fallback (disabled in v1) ---
LLM_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:12b

# --- Web ---
WEB_PORT=5173
