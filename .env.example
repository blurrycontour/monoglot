# --- Images ---
# Where `docker compose up -d` pulls from on a production host. A checkout
# builds from source instead (docker-compose.override.yml) and ignores these.
IMAGE_REGISTRY=ghcr.io/blurrycontour
IMAGE_TAG=latest

# --- Database ---
# SQLite lives on the same volume as audio and transcripts.
DATABASE_PATH=/data/monoglot.db

# --- API ---
API_PORT=8080
# Single static bearer token. Generate with: openssl rand -hex 32
AUTH_TOKEN=changeme-run-openssl-rand-hex-32
AUDIO_DIR=/data/audio
RAW_DIR=/data/raw
WORKER_URL=http://worker:9000
# Release APK served by the /download install page
APK_PATH=/data/apk/monoglot.apk
# Nightly ingest (in-process cron), 24h clock, server local time
INGEST_CRON_HOUR=3
INGEST_CRON_MINUTE=30
INGEST_ON_START=false
# Machine-translation fallback for words the dictionary does not have, via
# MyMemory. Set to 0 to disable and leave such taps showing nothing.
TRANSLATE_FALLBACK=1

# --- Whisper worker ---
WHISPER_MODEL=KBLab/kb-whisper-small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=5
# Release the model after this many idle seconds, so the worker does not hold
# ~600MB between nightly runs. 0 disables. Reload costs ~45s.
WHISPER_IDLE_UNLOAD_SECONDS=600
WORKER_PORT=9000

# --- LLM fallback (disabled in v1) ---
LLM_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=gemma3:12b

# --- Web ---
WEB_PORT=5173
