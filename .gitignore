# Secrets
.env
.env.*
!.env.example

# Signing keys — back these up privately. Losing them means Android will
# refuse every future update of the app.
android/release.keystore
android/keystore.properties

# Content, audio, models and generated artefacts.
#
# Anchored with a leading slash on purpose: an unanchored `data/` matches a
# directory of that name at ANY depth, which silently excluded the app's own
# `.../io/blurrycontour/monoglot/data/` package from git. A clean checkout then did
# not compile. Keep new entries anchored unless they are genuinely meant to
# match everywhere.
/data/
/models/
*.apk
*.log

# Android / Gradle build state
android/.gradle/
android/build/
android/app/build/
android/local.properties
# Gradle home when it is cached as a directory rather than a docker volume.
.gradle-cache/
.kotlin/
android/.kotlin/

# Python
__pycache__/
*.pyc
.venv/

# Editors
.idea/
*.iml
.DS_Store

# Local tool state
.claude/settings.local.json

AGENTS.md
